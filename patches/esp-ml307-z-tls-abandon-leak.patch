@@ -18,9 +18,16 @@ HttpClient::~HttpClient() {
     if (connected_) {
         Close();
     }
+    LeakAbandonedTransport();
     vEventGroupDelete(event_group_handle_);
 }
 
+void HttpClient::LeakAbandonedTransport() {
+    if (tcp_ && tcp_->ReceiveAbandoned()) {
+        (void)tcp_.release();
+    }
+}
+
 void HttpClient::SetTimeout(int timeout_ms) {
     timeout_ms_ = timeout_ms;
 }
