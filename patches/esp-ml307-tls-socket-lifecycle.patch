 #include <unistd.h>
 
 static const char *TAG = "EspSsl";
@@ -17,7 +18,7 @@ EspSsl::EspSsl() {
 EspSsl::~EspSsl() {
     Disconnect();
 
-    if (event_group_ != nullptr) {
+    if (event_group_ != nullptr && !receive_abandoned_) {
         vEventGroupDelete(event_group_);
         event_group_ = nullptr;
     }
@@ -96,17 +97,33 @@ void EspSsl::Disconnect() {
     
     // Close socket if it is open
     if (tls_client_ != nullptr) {
-        int sockfd;
-        ESP_ERROR_CHECK(esp_tls_get_conn_sockfd(tls_client_, &sockfd));
-        if (sockfd >= 0) {
-            close(sockfd);
-        }
-    
-        auto bits = xEventGroupWaitBits(event_group_, ESP_SSL_EVENT_RECEIVE_TASK_EXIT, pdFALSE, pdFALSE, pdMS_TO_TICKS(10000));
-        if (!(bits & ESP_SSL_EVENT_RECEIVE_TASK_EXIT)) {
-            ESP_LOGE(TAG, "Failed to wait for receive task exit");
+        int sockfd = -1;
+        // SDK析构拥有close权；先close会让其他任务复用fd，再被旧TLS二次close误杀。
+        // shutdown只中断收发，不回收fd，接收线程退出后再由SDK唯一释放。
+        if (esp_tls_get_conn_sockfd(tls_client_, &sockfd) == ESP_OK && sockfd >= 0) {
+            shutdown(sockfd, SHUT_RDWR);
         }
 
+        EventBits_t bits = 0;
+        int rounds = 0;
+        constexpr int kTlsReceiveExitWaitRounds = 3;
+        do {
+            bits = xEventGroupWaitBits(event_group_, ESP_SSL_EVENT_RECEIVE_TASK_EXIT,
+                                      pdFALSE, pdFALSE, pdMS_TO_TICKS(10000));
+            rounds++;
+            if (bits & ESP_SSL_EVENT_RECEIVE_TASK_EXIT) {
+                break;
+            }
+            if (rounds >= kTlsReceiveExitWaitRounds) {
+                // 有限等待后放弃所有权：不destroy仍被接收线程使用的TLS，也不删其事件组。
+                ESP_LOGE(TAG, "TLS receive task did not exit after shutdown; leaking socket ownership");
+                receive_abandoned_ = true;
+                tls_client_ = nullptr;
+                return;
+            }
+            ESP_LOGW(TAG, "Waiting for TLS receive task exit after shutdown");
+        } while (true);
+
         esp_tls_conn_destroy(tls_client_);
         tls_client_ = nullptr;
     }
@@ -154,8 +171,14 @@ void EspSsl::ReceiveTask() {
         }
 
         if (ret <= 0) {
-            if (ret < 0) {
-                ESP_LOGE(TAG, "SSL receive failed: %d", ret);
+            const int socket_error = errno;
+            const bool expected_shutdown = !connected_;
+            if (ret < 0 && !expected_shutdown) {
+                last_error_ = ret;
+                ESP_LOGE(TAG, "SSL receive failed: ret=%d errno=%d internal_free=%u largest=%u",
+                         ret, socket_error,
+                         (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL),
+                         (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL));
             }
             connected_ = false;
