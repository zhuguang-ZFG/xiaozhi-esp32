+}WebSocket::WebSocket(NetworkInterface* network, int connect_id) : state_(std::make_shared<State>(network, connect_id)) {}
+WebSocket::~WebSocket() { state_->Shutdown(); }
+std::shared_ptr<WebSocket::State> WebSocket::State::NewState() const {
+    auto next = std::make_shared<State>(network_, connect_id_);
+    next->headers_ = headers_;
+    next->receive_buffer_size_ = receive_buffer_size_;
+    next->on_data_ = on_data_;
+    next->on_connected_ = on_connected_;
+    next->on_disconnected_ = on_disconnected_;
+    next->on_error_ = on_error_;
+    next->on_pong_ = on_pong_;
+    return next;
+}
+bool WebSocket::Connect(const char* uri) {
+    auto next = state_->NewState();
+    state_->Shutdown();
+    state_ = std::move(next);
+    const bool connected = state_->Connect(uri);
+    if (!connected) state_->Shutdown();
+    return connected;
+}
