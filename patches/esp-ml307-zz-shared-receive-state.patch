+// State 被正在执行的回调持有；公共对象退场不会销毁其事件组或解析缓冲。
+HttpClient::HttpClient(NetworkInterface* network, int connect_id) : state_(std::make_shared<State>(network, connect_id)) {}
+HttpClient::~HttpClient() { state_->Shutdown(); }
+std::shared_ptr<HttpClient::State> HttpClient::State::NewState() const {
+    auto next = std::make_shared<State>(network_, connect_id_);
+    next->timeout_ms_ = timeout_ms_;
+    next->headers_ = headers_;
+    next->content_ = content_;
+    next->keep_alive_ = keep_alive_;
+    return next;
+}
+bool HttpClient::State::CanReuse(const std::string& url) const {
+    // 接收者可能正等待读者腾出队列；不能持此锁等待，用新状态关闭/唤醒旧请求。
+    std::unique_lock<std::mutex> lock(mutex_, std::try_to_lock);
+    return lock.owns_lock() && !retired_ &&
+           connected_origin_ == url.substr(0, url.find('/', url.find("://") + 3)) &&
+           IsConnectionReusable(host_, port_);
+}
+bool HttpClient::Open(const std::string& method, const std::string& url) {
+    if (!state_->CanReuse(url)) {
+        auto next = state_->NewState();
+        state_->Shutdown();
+        state_ = std::move(next);
+    }
+    return state_->Open(method, url);
+}
+void HttpClient::SetTimeout(int timeout_ms) { state_->SetTimeout(timeout_ms); }
+void HttpClient::SetHeader(const std::string& key, const std::string& value) { state_->SetHeader(key, value); }
+void HttpClient::SetContent(std::string&& content) { state_->SetContent(std::move(content)); }
+void HttpClient::Close() { state_->Close(); }
+int HttpClient::Read(char* buffer, size_t buffer_size) { return state_->Read(buffer, buffer_size); }
+int HttpClient::Write(const char* buffer, size_t buffer_size) { return state_->Write(buffer, buffer_size); }
+void HttpClient::SetKeepAlive(bool enable) { state_->SetKeepAlive(enable); }
+bool HttpClient::IsConnectionReusable(const std::string& host, int port) const { return state_->IsConnectionReusable(host, port); }
+int HttpClient::GetStatusCode() { return state_->GetStatusCode(); }
+std::string HttpClient::GetResponseHeader(const std::string& key) const { return state_->GetResponseHeader(key); }
+size_t HttpClient::GetBodyLength() { return state_->GetBodyLength(); }
+std::string HttpClient::ReadAll() { return state_->ReadAll(); }
